NODE_ENV=development
PORT=3000
APP_NAME=my-backend

DATABASE_URL=postgresql://user:password@localhost:5432/mydb

# Use openssl rand -base64 48 to generate strong secrets
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-another-long-random-string-32-chars

JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

LOG_LEVEL=debug
