{
  "name": "Booking-api",
  "version": "1.0.0",
  "description": "",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.app.json",
    "start": "node dist/main/main.js",
    "dev": "tsx watch -r tsconfig-paths/register src/main/main.ts",
    "test": "jest --config jest.config.ts",
    "test:watch": "jest --config jest.config.ts --watch",
    "test:coverage": "jest --config jest.config.ts --coverage",
    "test:integration": "jest --config jest.integration.config.ts",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "check": "biome check --write ./src",
    "prepare": "husky"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "bcrypt": "^6.0.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "fastify": "^5.8.5",
    "jsonwebtoken": "^9.0.3",
    "pg-promise": "^12.6.2",
    "pino": "^9.3.2",
    "pino-pretty": "^11.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.3",
    "@commitlint/cli": "^19.3.0",
    "@commitlint/config-conventional": "^19.2.2",
    "@swc/core": "^1.7.0",
    "@swc/jest": "^0.2.36",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.0.0",
    "@types/pg-promise": "^0.0.28",
    "husky": "^9.1.1",
    "jest": "^29.7.0",
    "lint-staged": "^15.2.7",
    "testcontainers": "^11.14.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": ["biome check --write --no-errors-on-unmatched"]
  }
}
